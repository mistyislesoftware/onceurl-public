{
  "name": "onceurl",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "bootstrap": "bash scripts/local/bootstrap.sh",
    "build": "pnpm --filter @onceurl/web build && pnpm -r --filter !@onceurl/web --filter !onceurl build",
    "build:functional": "pnpm --filter @onceurl/web build && pnpm --filter @onceurl/worker... build",
    "build:marketing": "pnpm --filter @onceurl/marketing build",
    "audit:dependencies": "pnpm audit --audit-level high",
    "dev": "pnpm --filter @onceurl/web dev",
    "dev:check": "node scripts/local/start.mjs --check",
    "dev:local": "node scripts/local/start.mjs",
    "dev:marketing": "pnpm --filter @onceurl/marketing dev",
    "env:check": "node scripts/local/toolchain.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run --exclude apps/worker/src/platform.integration.test.ts --exclude apps/marketing/src/platform.integration.test.ts --exclude packages/testing/src/deployable-artifacts.integration.test.ts --exclude scripts/local/platform.integration.test.mjs --exclude apps/worker/src/capability-durable-object.runtime.test.ts --exclude apps/worker/src/abuse-control-durable-object.runtime.test.ts --exclude apps/worker/src/capability-delivery.runtime.test.ts && pnpm test:worker-runtime",
    "test:browser": "playwright test",
    "test:worker-runtime": "vitest run --config apps/worker/src/vitest.runtime.config.ts",
    "typecheck": "pnpm -r typecheck",
    "dev:platform": "pnpm --filter @onceurl/web build && pnpm --filter @onceurl/worker dev",
    "test:integration": "pnpm build:functional && pnpm build:marketing && vitest run --maxWorkers=1 apps/worker/src/platform.integration.test.ts apps/marketing/src/platform.integration.test.ts packages/testing/src/deployable-artifacts.integration.test.ts scripts/local/platform.integration.test.mjs",
    "test:local-environment": "vitest run scripts/local/environment.test.mjs scripts/local/lifecycle.test.mjs && pnpm dev:check",
    "openapi:validate": "redocly lint docs/openapi.yaml",
    "cf:types": "pnpm cf:types:functional && pnpm cf:types:marketing",
    "cf:types:functional": "wrangler types apps/worker/worker-configuration.d.ts --config apps/worker/wrangler.jsonc --env-interface CloudflareBindings",
    "cf:types:marketing": "wrangler types apps/marketing/worker-configuration.d.ts --config apps/marketing/wrangler.jsonc --env-interface MarketingCloudflareBindings",
    "cf:types:check": "pnpm cf:types:functional --check && pnpm cf:types:marketing --check",
    "db:generate": "node scripts/database/generate-migrations.mjs",
    "db:migrations:check": "node scripts/database/check-migrations.mjs",
    "db:migrate:local": "node scripts/database/local-migrations.mjs apply",
    "db:migrations:list:local": "node scripts/database/local-migrations.mjs list",
    "db:seed:local": "node scripts/local/seed.mjs",
    "db:test:migrations": "node scripts/database/test-migrations.mjs",
    "local:reset": "node scripts/local/reset.mjs",
    "repository-policy:check": "node scripts/publication/verify.mjs content",
    "wrangler:validate": "pnpm wrangler:validate:functional && pnpm wrangler:validate:marketing && pnpm wrangler:validate:preview && pnpm wrangler:validate:staging",
    "wrangler:validate:functional": "pnpm build:functional && wrangler deploy --config apps/worker/wrangler.jsonc --env=\"\" --dry-run --outdir .tmp/wrangler-functional-dry-run",
    "wrangler:validate:marketing": "pnpm build:marketing && wrangler deploy --config apps/marketing/wrangler.jsonc --env=\"\" --dry-run --outdir .tmp/wrangler-marketing-dry-run",
    "wrangler:validate:preview": "pnpm build && wrangler deploy --config apps/worker/wrangler.jsonc --env preview --dry-run --outdir .tmp/wrangler-functional-preview-dry-run && wrangler deploy --config apps/marketing/wrangler.jsonc --env preview --dry-run --outdir .tmp/wrangler-marketing-preview-dry-run",
    "validate:local": "pnpm env:check && pnpm db:migrations:check && pnpm test:local-environment",
    "validate:repository": "node scripts/local/validate-repository.mjs",
    "wrangler:validate:staging": "pnpm build && wrangler deploy --config apps/worker/wrangler.jsonc --env staging --dry-run --outdir .tmp/wrangler-functional-staging-dry-run && wrangler deploy --config apps/marketing/wrangler.jsonc --env staging --dry-run --outdir .tmp/wrangler-marketing-staging-dry-run",
    "provenance:check": "node scripts/publication/verify.mjs provenance"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@redocly/cli": "^2.47.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "type": "module",
  "license": "UNLICENSED"
}
