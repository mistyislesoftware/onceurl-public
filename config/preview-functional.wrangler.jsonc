{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "onceurl-preview-functional",
  "main": "../preview-artifact/functional-worker/index.mjs",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": [],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "preview",
    "MARKETING_ORIGIN": "https://marketing.preview.invalid",
    "FUNCTIONAL_ORIGIN": "https://functional.preview.invalid"
  },
  "assets": {
    "directory": "../preview-artifact/functional-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
